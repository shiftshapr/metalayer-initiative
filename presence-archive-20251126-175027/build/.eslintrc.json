{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "no-console": "error",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-unused-vars": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-console": [
          "error",
          {
            "allow": []
          }
        ]
      }
    },
    {
      "files": ["src/types/**/*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "Property[key.name=/^[a-z]+(_[a-z]+)+$/]",
            "message": "snake_case fields are not allowed in type definitions. Use camelCase instead. Convert at API boundary using ApiBoundaryHelpers."
          }
        ]
      }
    },
    {
      "files": [
        "**/DIAGNOSTIC_*.ts",
        "**/diagnose-*.ts",
        "**/migrate-*.ts",
        "**/security-audit-*.ts",
        "**/Logger.ts",
        "src/scripts/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/**/*.ts", "routes/**/*.js", "controllers/**/*.js", "services/**/*.js"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.property.name='eq'] > Literal[value='email']",
            "message": "UUID-Only Policy: Do not use .eq('email') - use UUID for lookups"
          },
          {
            "selector": "MemberExpression[property.name='email'] > BinaryExpression[operator='===']",
            "message": "UUID-Only Policy: Do not match users by email - use UUID (user.id === message.authorId)"
          },
          {
            "selector": "Literal[value='x-user-email'], Literal[value='X-User-Email']",
            "message": "UUID-Only Policy: Do not use x-user-email header - use x-user-id only"
          },
          {
            "selector": "CallExpression[callee.name='setTimeout'][arguments.length>=2][arguments.1.value>=100]",
            "message": "ANTI-PATTERN: setTimeout delays are race condition workarounds. Use proper async coordination: await events, promises, or dependency injection. See .cursorrules 'Async Coordination Best Practices' section."
          },
          {
            "selector": "CallExpression[callee.name='setTimeout'][arguments.length>=2][arguments.1.type='Identifier']",
            "message": "ANTI-PATTERN: setTimeout with variable delays suggests race condition workaround. Use proper async coordination instead. See .cursorrules 'Async Coordination Best Practices' section."
          }
        ]
      }
    }
  ]
}

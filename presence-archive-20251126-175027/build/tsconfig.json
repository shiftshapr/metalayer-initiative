{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
  "outDir": "dist",
  "rootDir": "src",
  "strict": true,
  "noUnusedLocals": true,
  "noUnusedParameters": true,
  "noImplicitReturns": true,
  "noFallthroughCasesInSwitch": true,
  "noUncheckedIndexedAccess": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true,
  "resolveJsonModule": true,
  "declaration": false,
  "declarationMap": false,
  "sourceMap": false,
  "allowSyntheticDefaultImports": true,
  "noEmitOnError": false,
  "types": ["chrome", "node"]
},
"include": [
  "src/**/*"
],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/diagnose*.ts",
    "**/*diagnostic*.ts",
    "**/scripts/**/*.ts",
    "**/extension/utils/*diagnostic*.ts"
  ]
}


{
  "name": "metalayer-initiative",
  "version": "1.0.0",
  "description": "Metaweb-inspired coordination layer enabling human-avatar (agent) interaction with community-aware policies, messaging, and presence tracking",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node test.js",
    "build:presence": "cd presence && tsc -p tsconfig.json",
    "build:extension": "cd presence && bash scripts/build-distribution.sh",
    "clean:presence": "cd presence && bash scripts/cleanup-distribution.sh",
    "test:diagnostics": "vitest run --config vitest.config.ts",
    "ci:presence": "npm run build:presence && npm run test:diagnostics",
    "sync": "./sync-extension.sh",
    "watch": "./watch-sync.sh",
    "lint:fallbacks": "node presence/scripts/enforce-fallback-policy.js"
  },
  "keywords": [
    "metaweb",
    "coordination",
    "human-agent-interaction",
    "community-policies",
    "messaging",
    "presence-tracking"
  ],
  "author": "Bridgit-SPC",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@supabase/supabase-js": "^2.58.0",
    "axios": "^1.13.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.0.10",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.10"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

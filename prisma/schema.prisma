generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model message_deletions {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id String
  deleted_by String
  deleted_at DateTime? @default(now()) @db.Timestamptz(6)
  page_id    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([deleted_at], map: "idx_message_deletions_deleted_at")
  @@index([message_id], map: "idx_message_deletions_message_id")
  @@index([page_id], map: "idx_message_deletions_page")
  @@index([page_id], map: "idx_message_deletions_page_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id      String
  user_email   String
  content      String
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  community_id String    @default("comm-001")
  parent_id    String?

  @@index([community_id], map: "idx_messages_community_id")
  @@index([page_id, community_id], map: "idx_messages_page_community")
  @@index([page_id], map: "idx_messages_page_id")
  @@index([parent_id], map: "idx_messages_parent_id")
  @@index([user_email], map: "idx_messages_user_email")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reactions {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id String    @db.Uuid
  emoji      String
  user_email String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([message_id], map: "idx_reactions_message")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_presence {
  id         String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_email String
  user_name  String?
  page_id    String
  page_url   String
  is_active  Boolean?  @default(true)
  last_seen  DateTime? @default(now()) @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  enter_time DateTime? @db.Timestamptz(6)
  
  // Relationship to AppUser for user profile data
  AppUser    AppUser?  @relation(fields: [user_email], references: [email])

  @@id([user_email, page_id])
  @@unique([user_email, page_id], map: "user_presence_user_page_unique")
  @@index([page_id, user_email], map: "idx_presence_page_user")
  @@index([page_id], map: "idx_user_presence_page_id")
  @@index([user_email], map: "idx_user_presence_user_email")
}

// user_visibility model removed - table was dropped as unused

model Anchor {
  id             String         @id @db.Uuid
  pageSnapshotId String         @db.Uuid
  type           AnchorType
  selectors      Json
  bbox           Json?
  media          Json?
  snippet        String?
  confidence     Float          @default(1.0)
  createdAt      DateTime       @default(now())
  PageSnapshot   PageSnapshot   @relation(fields: [pageSnapshotId], references: [id], onDelete: Cascade)
  Conversation   Conversation[]

  @@index([pageSnapshotId])
  @@index([type])
}

model AppUser {
  id               String             @id @db.Uuid
  handle           String             @unique
  email            String?            @unique
  name             String?
  avatarUrl        String             // Changed from String? to String (non-null required)
  isVerified       Boolean            @default(false)
  isSuperAdmin     Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  auraColor        String?
  Conversation     Conversation[]
  ModerationAction ModerationAction[]
  Post             Post[]
  PresenceEvent    PresenceEvent[]
  Reaction         Reaction[]
  SpaceMember      SpaceMember[]
  user_presence    user_presence[] // Relationship to user_presence
}

model Conversation {
  id          String     @id @db.Uuid
  pageId      String     @db.Uuid
  anchorId    String?    @db.Uuid
  visibility  Visibility
  title       String?
  tags        String[]
  status      Status     @default(OPEN)
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  communityId String?
  Anchor      Anchor?    @relation(fields: [anchorId], references: [id])
  AppUser     AppUser    @relation(fields: [createdById], references: [id])
  Page        Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  Post        Post[]
  Reaction    Reaction[]

  @@index([anchorId])
  @@index([communityId])
  @@index([status])
  @@index([pageId, updatedAt(sort: Desc)], map: "conversation_list_ix")
}

model ModerationAction {
  id         String   @id @db.Uuid
  actorId    String   @db.Uuid
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())
  AppUser    AppUser  @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
}

model Page {
  id                                               String          @id @db.Uuid
  spaceId                                          String?         @db.Uuid
  url                                              String
  canonicalUrl                                     String
  title                                            String?
  description                                      String?
  latestSnapshotId                                 String?         @db.Uuid
  createdAt                                        DateTime        @default(now())
  updatedAt                                        DateTime
  Conversation                                     Conversation[]
  PageSnapshot_Page_latestSnapshotIdToPageSnapshot PageSnapshot?   @relation("Page_latestSnapshotIdToPageSnapshot", fields: [latestSnapshotId], references: [id])
  Space                                            Space?          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  PageSnapshot_PageSnapshot_pageIdToPage           PageSnapshot[]  @relation("PageSnapshot_pageIdToPage")
  PresenceEvent                                    PresenceEvent[]

  @@unique([spaceId, canonicalUrl])
  @@index([canonicalUrl])
}

model PageSnapshot {
  id                                       String    @id @db.Uuid
  pageId                                   String    @db.Uuid
  contentHash                              Bytes
  simhash                                  BigInt
  etag                                     String?
  lastModified                             DateTime?
  screenshotKey                            String?
  createdAt                                DateTime  @default(now())
  Anchor                                   Anchor[]
  Page_Page_latestSnapshotIdToPageSnapshot Page[]    @relation("Page_latestSnapshotIdToPageSnapshot")
  Page_PageSnapshot_pageIdToPage           Page      @relation("PageSnapshot_pageIdToPage", fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt(sort: Desc)])
}

model Post {
  id                 String       @id @db.Uuid
  conversationId     String       @db.Uuid
  parentId           String?      @db.Uuid
  authorId           String       @db.Uuid
  body               String
  attachments        Json?
  createdAt          DateTime     @default(now())
  editedAt           DateTime?
  visibilityOverride Visibility?
  deletedAt          DateTime?
  AppUser            AppUser      @relation(fields: [authorId], references: [id])
  Conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Post               Post?        @relation("PostToPost", fields: [parentId], references: [id])
  other_Post         Post[]       @relation("PostToPost")
  Reaction           Reaction[]

  @@index([authorId])
  @@index([parentId])
  @@index([conversationId, createdAt], map: "post_list_ix")
}

model PresenceEvent {
  id           BigInt            @id @default(autoincrement())
  pageId       String            @db.Uuid
  userId       String            @db.Uuid
  kind         PresenceEventKind
  availability Availability?
  customLabel  String?
  createdAt    DateTime          @default(now())
  Page         Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  AppUser      AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt(sort: Desc)])
  @@index([userId])
}

model Reaction {
  id             String        @id @db.Uuid
  userId         String        @db.Uuid
  conversationId String?       @db.Uuid
  postId         String?       @db.Uuid
  kind           ReactionKind
  createdAt      DateTime      @default(now())
  emoji          String?
  Conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  AppUser        AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId, postId], map: "unique_user_target")
  @@index([conversationId])
  @@index([postId])
}

model Space {
  id          String        @id @db.Uuid
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Page        Page[]
  SpaceMember SpaceMember[]
}

model SpaceMember {
  spaceId  String   @db.Uuid
  userId   String   @db.Uuid
  role     Role
  joinedAt DateTime @default(now())
  Space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  AppUser  AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
}

enum AnchorType {
  PAGE
  REGION
  TEXT
  MEDIA
  COMPOSITE
}

enum Availability {
  AVAILABLE
  BUSY
  AWAY
  CUSTOM
}

enum PresenceEventKind {
  ENTER
  EXIT
  AVAILABILITY
}

enum ReactionKind {
  AGREE
  QUESTION
  CITE
  FLAG
  DISAGREE
  LOVE
  LAUGH
  CLARIFY
}

enum Role {
  OWNER
  MODERATOR
  MEMBER
  VISITOR
}

enum Status {
  OPEN
  RESOLVED
  ARCHIVED
  FLAGGED
}

enum Visibility {
  PUBLIC
  COMMUNITY
  GROUP
  PRIVATE
  CUSTOM
}

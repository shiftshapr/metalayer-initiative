#!/bin/sh
# Pre-commit hook to prevent policy violations

. "$(dirname "$0")/_/husky.sh"

# Check for 'as any' in critical files
CRITICAL_FILES=$(git diff --cached --name-only | grep -E "(auth|user|identif|match|filter)" | grep "\.ts$" || true)

if [ -n "$CRITICAL_FILES" ]; then
  for file in $CRITICAL_FILES; do
    if git diff --cached "$file" | grep -q "as any\|as unknown"; then
      echo "❌ ERROR: Type assertion (as any/as unknown) in critical file: $file"
      echo "   Please fix or add comment explaining why it's safe."
      echo "   Example: // @ts-expect-error - Reason: [explanation]"
      exit 1
    fi
  done
fi

# Check for email-based matching
if git diff --cached --name-only | grep "\.ts$" | xargs grep -l "\.eq('email'\|findUnique.*email\|user\.email\s*===" 2>/dev/null; then
  echo "❌ ERROR: Email-based matching found. Use UUID only!"
  exit 1
fi

# Check for email headers
if git diff --cached --name-only | grep "\.ts$" | xargs grep -l "x-user-email\|user-email" 2>/dev/null; then
  echo "❌ ERROR: Email headers found. Use x-user-id only!"
  exit 1
fi

echo "✅ Pre-commit checks passed"

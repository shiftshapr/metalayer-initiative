{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
  "outDir": ".",
  "rootDir": "src",
  "strict": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true,
  "resolveJsonModule": true,
  "declaration": false,
  "declarationMap": false,
  "sourceMap": false,
  "allowSyntheticDefaultImports": true,
  "noEmitOnError": false,
  "types": ["chrome", "node"]
},
"include": [
  "src/**/*"
],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}

